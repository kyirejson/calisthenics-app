<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <queries>
    <package android:name="com.netease.cloudmusic" />
    <package android:name="com.tencent.qqmusic" />
    <package android:name="moe.shizuku.privileged.api" />
  </queries>
  <application>
    <provider android:name="rikka.shizuku.ShizukuProvider" android:authorities="${applicationId}.shizuku" android:enabled="true" android:exported="true" android:multiprocess="false" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <service android:name="uncover.music.MusicExecutionService" android:exported="false" android:foregroundServiceType="specialUse" android:stopWithTask="true">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Maintains only the current user-initiated music-selection model request across app switches, using optional foreground UI or an authorized dedicated virtual display; visible cancel action; stops when the request finishes or is cancelled. Does not play or record audio." />
    </service>
    <service android:name="uncover.music.MusicAccessibilityService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:label="@string/uncover_music_service_name">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/uncover_music_accessibility" />
      <meta-data android:name="uncover.phone_control" android:value="true" />
    </service>
    <service android:name="uncover.music.MusicNotificationListener" android:exported="true" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:label="@string/uncover_music_playback_name">
      <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
    </service>
  </application>
</manifest>
