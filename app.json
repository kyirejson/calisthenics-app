{
  "expo": {
    "name": "Uncover",
    "slug": "uncover",
    "version": "1.7.11",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "uncover",
    "extra": {
      "updateChannel": "preview",
      "eas": {
        "projectId": "f6e5af9d-46ec-4f38-be5e-ec267e071eb7"
      }
    },
    "plugins": [
      "expo-secure-store",
      "./modules/uncover-music/plugin.cjs"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zizhong.jinjie",
      "buildNumber": "20"
    },
    "android": {
      "package": "com.zizhong.jinjie",
      "versionCode": 20,
      "blockedPermissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#151712",
        "foregroundImage": "./assets/app-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "kyirechou"
  }
}
