{
  "name": "uncover-app",
  "version": "1.7.8",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.24",
    "fflate": "^0.8.2",
    "marked": "^18.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-public-resources.cjs && node scripts/verify-release-resources.cjs",
    "prepare:public": "node scripts/prepare-public-resources.cjs",
    "start": "expo start",
    "dev:phone": "expo start --host lan --port 8082",
    "dev:tunnel": "expo start --tunnel --port 8082",
    "dev:web": "expo start --web --host lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "benchmark:architecture": "node --expose-gc scripts/benchmark-architecture.cjs",
    "test": "node scripts/test-all.cjs",
    "check": "npm run typecheck && npm test",
    "knowledge:check": "node scripts/check-knowledge-vault.mjs",
    "prepare:originals": "node scripts/prepare-original-resources.cjs",
    "test:domain": "node --test scripts/test-domain.cjs",
    "test:equipment": "node --test scripts/test-equipment.cjs",
    "test:equipment-training": "node --test scripts/test-equipment-training.cjs scripts/test-equipment-coverage.cjs",
    "test:updates": "node --test scripts/test-updates.cjs",
    "test:history": "node --test scripts/test-history-redesign.cjs",
    "test:weight": "node --test scripts/test-weight-chart.cjs",
    "test:nutrition": "node --test scripts/test-nutrition.cjs scripts/test-nutrition-journal.cjs scripts/test-nutrition-store.cjs scripts/test-nutrition-vision.cjs scripts/test-nutrition-loop.cjs scripts/test-nutrition-presentation.cjs scripts/test-food-import.cjs scripts/test-nutrition-photo-history.cjs scripts/test-food-artwork.cjs",
    "test:food-import": "node --test scripts/test-food-import.cjs",
    "test:food-artwork": "node --test scripts/test-food-artwork.cjs",
    "knowledge:build": "node scripts/build-knowledge-vault.mjs",
    "knowledge:import": "node scripts/import-knowledge-vault.mjs"
  },
  "private": true
}
